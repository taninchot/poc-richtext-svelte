DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Upload storage: local or r2
UPLOAD_STORAGE=local

# Required when UPLOAD_STORAGE=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://assets.example.com
R2_PREFIX=uploads

# Optional override. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# For presigned browser uploads, configure R2 CORS to allow PUT from your app origin
# with Content-Type and Cache-Control request headers.
